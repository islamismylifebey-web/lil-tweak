# Copy these names into the service manager's protected environment file.
# Never place production values in source control or inside a sandbox.
LIL_TWEAK_DATABASE_URL=postgresql://lil_tweak_app:CHANGE_ME@127.0.0.1:5432/lil_tweak
LIL_TWEAK_SIGNING_KEYS_JSON={"primary":"CHANGE_ME_WITH_AT_LEAST_32_BYTES!!"}
# Exact 32-lowerhex owner scope from the Cloudflare control plane.
LIL_TWEAK_CANONICAL_OWNER_ID=REPLACE_WITH_CF_OWNER_SCOPE_32_LOWERHEX
OPENAI_API_KEY=CHANGE_ME
LIL_TWEAK_OPENAI_MODEL=gpt-5.6-terra
LIL_TWEAK_RUNNER_IMAGE=registry.example.invalid/lil-tweak-runner@sha256:CHANGE_ME
LIL_TWEAK_WORK_ROOT=/srv/lil-tweak/jobs
LIL_TWEAK_WORK_ROOT_INODES=204800
LIL_TWEAK_EVIDENCE_BUCKET=lil-tweak-private-evidence
LIL_TWEAK_EVIDENCE_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
LIL_TWEAK_R2_ACCESS_KEY_ID=CHANGE_ME
LIL_TWEAK_R2_SECRET_ACCESS_KEY=CHANGE_ME
LIL_TWEAK_GIT_ALLOWED_HOSTS=github.com
LIL_TWEAK_MAX_ADMITTED_JOBS=1
LIL_TWEAK_JOB_TIMEOUT_SECONDS=1200

# GALOR is disabled for this release. Do not add LIL_TWEAK_GALOR_READONLY_URL.
