{
  "contract": "galor-runner",
  "version": "2.0.0",
  "owner": "islamismylifebey-web/galor-hub",
  "consumers": [
    "islamismylifebey-web/lil-tweak"
  ],
  "executionHost": "galor-private-cloud-01",
  "summary": "GALOR Hub owns the secure execution boundary. Independent engines submit signed, typed job envelopes; the Hub authenticates, validates, authorizes, executes in an isolated workspace, and returns evidence. No unrestricted shell access is exposed.",
  "signing": {
    "algorithm": "HMAC-SHA256",
    "canonicalPayload": [
      "envelope.keyId",
      "envelope.issuedAt",
      "envelope.expiresAt",
      "envelope.nonce",
      "request.jobId",
      "request.dispatchId",
      "request.operation",
      "request.repository.source",
      "request.repository.commit",
      "request.repository.ref",
      "request.script",
      "request.workingDirectory",
      "request.args",
      "request.idempotencyKey",
      "request.tenantId",
      "request.actor",
      "request.correlationId",
      "request.limits.timeoutMs",
      "request.limits.maxOutputBytes",
      "request.limits.maxMemoryBytes",
      "request.limits.maxCpuMs",
      "request.limits.maxWorkspaceBytes",
      "request.secretNames",
      "request.approvalId",
      "request.input"
    ],
    "signatureEncoding": "lowercase hex",
    "maxClockSkewMs": 30000,
    "defaultTtlMs": 60000,
    "replayProtection": "Each nonce may be consumed once inside the clock-skew window; reuse is rejected as REPLAYED_REQUEST.",
    "secretHandling": "The signing secret is server-side only and must never reach browser or client code."
  },
  "operations": [
    {
      "operation": "install",
      "command": "npm",
      "args": [
        "ci",
        "--ignore-scripts"
      ],
      "networkAllowed": true,
      "networkAllowedHosts": [
        "registry.npmjs.org"
      ],
      "timeoutMs": 480000,
      "maxExtraArgs": 2,
      "artifacts": [
        "package-lock.json"
      ]
    },
    {
      "operation": "typecheck",
      "command": "npm",
      "args": [
        "run",
        "typecheck"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 300000,
      "maxExtraArgs": 0,
      "artifacts": []
    },
    {
      "operation": "lint",
      "command": "npm",
      "args": [
        "run",
        "lint"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 300000,
      "maxExtraArgs": 0,
      "artifacts": []
    },
    {
      "operation": "unit_tests",
      "command": "npm",
      "args": [
        "test"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 600000,
      "maxExtraArgs": 4,
      "artifacts": []
    },
    {
      "operation": "integration_tests",
      "command": "npm",
      "args": [
        "run",
        "test:integration"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 900000,
      "maxExtraArgs": 4,
      "artifacts": []
    },
    {
      "operation": "e2e_tests",
      "command": "npm",
      "args": [
        "run",
        "test:e2e"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 900000,
      "maxExtraArgs": 4,
      "artifacts": []
    },
    {
      "operation": "build",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 900000,
      "maxExtraArgs": 0,
      "artifacts": [
        "dist",
        ".next"
      ]
    },
    {
      "operation": "artifact_validation",
      "command": "npm",
      "args": [
        "run",
        "validate:artifact"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 300000,
      "maxExtraArgs": 0,
      "artifacts": []
    },
    {
      "operation": "repository_inspection",
      "command": "git",
      "args": [
        "log",
        "--max-count=20",
        "--pretty=%H %s"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 60000,
      "maxExtraArgs": 2,
      "artifacts": []
    },
    {
      "operation": "patch_validation",
      "command": "git",
      "args": [
        "apply",
        "--check"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 120000,
      "maxExtraArgs": 1,
      "artifacts": []
    },
    {
      "operation": "migration_validation",
      "command": "npm",
      "args": [
        "run",
        "db:generate"
      ],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 300000,
      "maxExtraArgs": 0,
      "artifacts": [
        "drizzle"
      ]
    },
    {
      "operation": "approved_script",
      "command": "bash",
      "args": [],
      "networkAllowed": false,
      "networkAllowedHosts": [],
      "timeoutMs": 600000,
      "maxExtraArgs": 4,
      "artifacts": []
    }
  ],
  "actions": [
    {
      "action": "runner.applyPatch",
      "operation": "approved_script",
      "inputFields": [
        "patch"
      ],
      "approvalClass": "write",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "git-diff"
      ]
    },
    {
      "action": "runner.gitDiff",
      "operation": "approved_script",
      "inputFields": [
        "path",
        "patch"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "git-diff"
      ]
    },
    {
      "action": "runner.gitStatus",
      "operation": "approved_script",
      "inputFields": [],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "git-status"
      ]
    },
    {
      "action": "runner.inspectRepository",
      "operation": "approved_script",
      "inputFields": [
        "path"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "list-files"
      ]
    },
    {
      "action": "runner.prepareLocalCommit",
      "operation": "approved_script",
      "inputFields": [
        "message",
        "patch"
      ],
      "approvalClass": "commit",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "prepare-commit"
      ]
    },
    {
      "action": "runner.readRepositoryFile",
      "operation": "approved_script",
      "inputFields": [
        "path"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "read-file"
      ]
    },
    {
      "action": "runner.reportIdentity",
      "operation": "approved_script",
      "inputFields": [],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-report-identity.sh"
    },
    {
      "action": "runner.searchRepository",
      "operation": "approved_script",
      "inputFields": [
        "query",
        "path"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "search"
      ]
    },
    {
      "action": "runner.verifyBuild",
      "operation": "approved_script",
      "inputFields": [
        "patch"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "verify-build"
      ]
    },
    {
      "action": "runner.verifyLint",
      "operation": "approved_script",
      "inputFields": [
        "patch"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "verify-lint"
      ]
    },
    {
      "action": "runner.verifyTests",
      "operation": "approved_script",
      "inputFields": [
        "patch"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "verify-tests"
      ]
    },
    {
      "action": "runner.verifyTypecheck",
      "operation": "approved_script",
      "inputFields": [
        "patch"
      ],
      "approvalClass": "none",
      "script": "apps/command-center/scripts/runner-engineering-action.sh",
      "args": [
        "verify-typecheck"
      ]
    }
  ],
  "approvedScripts": [
    "scripts/install-ci.sh",
    "scripts/build-verified.sh",
    "scripts/validate-artifact.sh",
    "scripts/sites-env.sh",
    "apps/command-center/scripts/runner-report-identity.sh",
    "apps/command-center/scripts/runner-engineering-action.sh"
  ],
  "jobLifecycle": {
    "states": [
      "queued",
      "preparing",
      "running",
      "succeeded",
      "failed",
      "cancelled",
      "timed_out"
    ],
    "terminalStates": [
      "succeeded",
      "failed",
      "cancelled",
      "timed_out"
    ]
  },
  "errorCodes": [
    "UNAUTHENTICATED",
    "SIGNATURE_INVALID",
    "REQUEST_EXPIRED",
    "REPLAYED_REQUEST",
    "COMMAND_NOT_ALLOWED",
    "ARGUMENT_REJECTED",
    "WORKSPACE_ESCAPE",
    "SECRET_DENIED",
    "NETWORK_DENIED",
    "LIMIT_EXCEEDED",
    "COMMIT_MISMATCH",
    "NOT_FOUND",
    "CANCELLED",
    "RUNNER_UNAVAILABLE"
  ],
  "resourceLimits": {
    "timeoutMs": 600000,
    "maxOutputBytes": 1048576,
    "maxMemoryBytes": 2147483648,
    "maxCpuMs": 900000,
    "maxWorkspaceBytes": 2147483648
  },
  "environment": {
    "allowlist": [
      "PATH",
      "HOME",
      "LANG",
      "TZ",
      "CI",
      "NODE_ENV",
      "RUNNER_NAME",
      "RUNNER_OS",
      "RUNNER_ARCH"
    ],
    "redactionPlaceholder": "[redacted-secret]",
    "secretsInjection": "Secret values from secretNames are resolved server-side and injected as environment variables; they are scrubbed from all captured output."
  },
  "verification": {
    "statuses": [
      "VERIFIED",
      "UNVERIFIED",
      "FAILED VERIFICATION"
    ],
    "rule": "VERIFIED requires every required verification step to have actually executed on the runner and passed. Work that was never verified is UNVERIFIED; work whose verification ran and failed is FAILED VERIFICATION. Generated code alone never yields VERIFIED."
  }
}
