isplay:block;font-size:.72rem;color:var(--muted);text-transform:uppercase}.status-item span{overflow-wrap:anywhere}.tabs{display:flex;gap:.35rem;overflow-x:auto;padding:.6rem 0}.tabs button{white-space:nowrap;background:#0a2148;border-color:var(--line)}.tabs button[aria-selected=true]{background:var(--sapphire);border-color:var(--blue)}.card{padding:1.15rem;min-height:360px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:1rem}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.form-grid label,.form-grid fieldset{display:grid;gap:.4rem;color:var(--muted)}.form-grid .wide{grid-column:1/-1}input,select,textarea{width:100%;background:#06132b;color:white;border:1px solid #315986;border-radius:9px;padding:.72rem}textarea{resize:vertical}fieldset{border:1px solid var(--line);border-radius:12px;padding:1rem}.pill{border-radius:999px;background:#143866;padding:.3rem .75rem;color:var(--blue);font-weight:800}.data-panel{background:#020916;border:1px solid var(--line);color:#d9e9ff;border-radius:12px;padding:1rem;overflow:auto;max-height:420px;white-space:pre-wrap;word-break:break-word}.hint{color:var(--muted)}.grid-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.7rem}.list-card{display:block;width:100%;text-align:left;border:1px solid var(--line);border-radius:10px;background:#081b38;color:white;padding:.8rem;margin:.55rem 0;overflow-wrap:anywhere}.list-card strong{color:var(--blue)}.toast{position:fixed;right:1rem;bottom:1rem;max-width:420px;padding:.8rem 1rem;border-radius:10px;background:#102f58;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1}@media(max-width:760px){.topbar{align-items:flex-start;flex-direction:column}.form-grid{grid-template-columns:1fr}.form-grid .wide{grid-column:auto}.app-shell{padding:.6rem}.card{border-radius:12px;padding:.9rem}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
