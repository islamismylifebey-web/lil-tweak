+                    EvidenceKind.TEST
+                    if step.phase in {StepPhase.TEST, StepPhase.VERIFICATION}
+                    else EvidenceKind.EXECUTED
+                )
+                self.store.append_evidence(
+                    task_id,
+                    kind=evidence_kind,
+                    event_type="tool_executed",
+                    payload={
+                        "run_id": run.id,
+                        "tool_id": run.tool_id,
+                        "request_digest": run.request_digest,
