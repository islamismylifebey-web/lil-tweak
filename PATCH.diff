+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    ("result", "expected"),
+    [
+        (ProcessResult(None, b"", b"timeout", True, False), "timeout"),
+        (ProcessResult(None, b"", b"canceled", False, True), "canceled"),
+        (ProcessResult(125, b"", b"[OUTPUT LIMIT REACHED]", False, False), "OUTPUT LIMIT"),
