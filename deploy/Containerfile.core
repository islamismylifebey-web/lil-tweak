ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS podman-client

ARG PODMAN_REMOTE_VERSION=6.1.2
ARG PODMAN_SOURCE_COMMIT=04f3aa430e6df81bea059978bc5bafbc846ba3e7
ARG PODMAN_GRPC_VERSION=1.83.2
ARG GO_VERSION=1.27.1
ARG GO_ARCHIVE=go1.27.1.linux-amd64.tar.gz
ARG GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445

ENV PATH=/usr/local/go/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl git make \
    && curl --fail --location --proto '=https' --tlsv1.2 \
        "https://go.dev/dl/${GO_ARCHIVE}" \
        --output "/tmp/${GO_ARCHIVE}" \
    && echo "${GO_SHA256}  /tmp/${GO_ARCHIVE}" | sha256sum --check \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf "/tmp/${GO_ARCHIVE}" \
    && git init /tmp/podman \
    && cd /tmp/podman \
    && git remote add origin https://github.com/containers/podman.git \
    && git fetch --depth=1 origin "${PODMAN_SOURCE_COMMIT}" \
    && git checkout --detach "${PODMAN_SOURCE_COMMIT}" \
    && test "$(git rev-parse HEAD)" = "${PODMAN_SOURCE_COMMIT}" \
    && go mod edit -require="google.golang.org/grpc@v${PODMAN_GRPC_VERSION}" \
    && go mod tidy \
    && go mod vendor \
    && test "$(go list -m -f '{{.Version}}' google.golang.org/grpc)" = "v${PODMAN_GRPC_VERSION}" \
    && make podman-remote-static-linux_amd64 \
    && install -m 0755 bin/podman-remote-static-linux_amd64 /podman \
    && /podman --version \
    && go version -m /podman | awk -F '\t' -v version="v${PODMAN_GRPC_VERSION}" '$2=="google.golang.org/grpc" && $3==version { found=1 } END { exit found ? 0 : 1 }'

FROM ${PYTHON_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CONTAINER_HOST=unix:///run/podman/podman.sock

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends ca-certificates git util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=podman-client /podman /usr/local/bin/podman
RUN podman --version

RUN groupadd --gid 10001 lil-tweak \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent lil-tweak

WORKDIR /app
COPY core/pyproject.toml /app/core/pyproject.toml
COPY core/lil_tweak /app/core/lil_tweak
RUN python -m pip install --no-cache-dir /app/core

COPY core/main.py /app/main.py
COPY core/prompts /app/prompts
COPY deploy/healthcheck.py /app/deploy/healthcheck.py
COPY deploy/verify_r2.py /app/deploy/verify_r2.py

USER 10001:10001
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
