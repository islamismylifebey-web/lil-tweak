ARG PYTHON_BASE_IMAGE
ARG PODMAN_REMOTE_STATIC_URL
ARG PODMAN_REMOTE_STATIC_SHA256
FROM ${PYTHON_BASE_IMAGE}
ARG PODMAN_REMOTE_STATIC_URL
ARG PODMAN_REMOTE_STATIC_SHA256

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CONTAINER_HOST=unix:///run/podman/podman.sock

RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update \
        && apt-get install --yes --no-install-recommends ca-certificates git util-linux \
        && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache ca-certificates git py3.12-pip python-3.12 util-linux; \
    else \
        echo "unsupported base image package manager" >&2; \
        exit 1; \
    fi

RUN test -n "${PODMAN_REMOTE_STATIC_URL}" \
    && test -n "${PODMAN_REMOTE_STATIC_SHA256}" \
    && mkdir -p /usr/local/bin \
    && python -c "import hashlib, os, sys, tarfile, urllib.request; url, expected, destination = sys.argv[1:4]; archive = '/tmp/podman-remote-static.tar.gz'; urllib.request.urlretrieve(url, archive); data = open(archive, 'rb').read(); actual = hashlib.sha256(data).hexdigest(); assert actual == expected, actual; package = tarfile.open(archive, 'r:gz'); member = package.getmember('bin/podman-remote-static-linux_amd64'); source = package.extractfile(member); assert source is not None; open(destination, 'wb').write(source.read()); os.chmod(destination, 0o755)" \
        "${PODMAN_REMOTE_STATIC_URL}" "${PODMAN_REMOTE_STATIC_SHA256}" /usr/local/bin/podman \
    && /usr/local/bin/podman --version

RUN if command -v groupadd >/dev/null 2>&1; then \
        groupadd --gid 10001 lil-tweak \
        && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent lil-tweak; \
    else \
        addgroup -g 10001 lil-tweak \
        && adduser -D -H -u 10001 -G lil-tweak -h /nonexistent lil-tweak; \
    fi

WORKDIR /app
COPY core/pyproject.toml /app/core/pyproject.toml
COPY core/lil_tweak /app/core/lil_tweak
RUN python -m pip install --no-cache-dir /app/core

COPY core/main.py /app/main.py
COPY core/prompts /app/prompts
COPY deploy/healthcheck.py /app/deploy/healthcheck.py
COPY deploy/verify_r2.py /app/deploy/verify_r2.py

USER 10001:10001
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
