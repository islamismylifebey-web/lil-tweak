ARG PYTHON_BASE_IMAGE

FROM ${PYTHON_BASE_IMAGE} AS podman-builder
USER root
ARG PODMAN_SOURCE_URL
ARG PODMAN_SOURCE_SHA256
RUN apk add --no-cache ca-certificates curl go-1.27 \
    && test -n "${PODMAN_SOURCE_URL}" \
    && test -n "${PODMAN_SOURCE_SHA256}" \
    && curl -fsSL -o /tmp/podman-source.tar.gz "${PODMAN_SOURCE_URL}" \
    && echo "${PODMAN_SOURCE_SHA256}  /tmp/podman-source.tar.gz" | sha256sum -c - \
    && mkdir /src \
    && tar -xzf /tmp/podman-source.tar.gz -C /src --strip-components=1 \
    && cd /src \
    && go get google.golang.org/grpc@v1.83.2 golang.org/x/crypto@v0.56.0 \
    && CGO_ENABLED=0 go build -mod=mod \
        -tags "remote exclude_graphdriver_btrfs containers_image_openpgp" \
        -o /podman ./cmd/podman \
    && /podman --version

FROM ${PYTHON_BASE_IMAGE}
USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CONTAINER_HOST=unix:///run/podman/podman.sock

RUN apk add --no-cache ca-certificates git util-linux
COPY --from=podman-builder /podman /usr/local/bin/podman
RUN podman --version

RUN addgroup -g 10001 lil-tweak \
    && adduser -D -H -u 10001 -G lil-tweak -h /nonexistent lil-tweak

WORKDIR /app
COPY core/pyproject.toml /app/core/pyproject.toml
COPY core/lil_tweak /app/core/lil_tweak
RUN python -m pip install --no-cache-dir /app/core

COPY core/main.py /app/main.py
COPY core/prompts /app/prompts
COPY deploy/healthcheck.py /app/deploy/healthcheck.py
COPY deploy/verify_r2.py /app/deploy/verify_r2.py

USER 10001:10001
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
