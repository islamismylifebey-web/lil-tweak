# Exact public Sites origin. No path, query, fragment, trailing slash, or workers.dev alias.
LIL_TWEAK_ENVIRONMENT=production
LIL_TWEAK_INGRESS_MODE=sites_native
PUBLIC_ORIGIN=https://REPLACE_WITH_SELECTED_SITE.chatgpt.site
# Native Sites authenticates visitors before forwarding their identity.
# Keep the actual Site owner-private. Do not set MANAGED_INGRESS_SECRET in this mode.
# For a separately provisioned trusted gateway only, use managed_assertion and
# configure MANAGED_INGRESS_SECRET (>=32 UTF-8 bytes) in its secret store.

# Access-protected Cloudflare Tunnel hostname for the trusted core.
CORE_ORIGIN=https://core.lil-tweak.invalid
CORE_ACCESS_CLIENT_ID=SET_IN_SECRET_STORE
CORE_ACCESS_CLIENT_SECRET=SET_IN_SECRET_STORE

# Independent HMAC authentication still applies behind Cloudflare Access.
# Placeholder is deliberately too short; use a secret of at least 32 UTF-8 bytes.
CORE_SIGNING_KEY_ID=primary
CORE_SIGNING_SECRET=SET_IN_SECRET_STORE
