ARG RUNNER_BASE_IMAGE
FROM ${RUNNER_BASE_IMAGE}

LABEL org.opencontainers.image.title="Lil Tweak sandbox runner" \
      org.opencontainers.image.description="Credential-free, network-disabled code execution toolchain"

RUN apk add --no-cache \
        cmake \
        go-1.26 \
        make \
        nodejs-22 \
        npm \
        openjdk-26-default-jdk \
        patch \
        py3.14-pytest \
        py3.14-pip \
        python-3.14 \
        rust-1.97 \
    && ! command -v git \
    && command -v patch \
    && command -v node \
    && command -v npm \
    && command -v python3 \
    && command -v pytest \
    && command -v go \
    && command -v rustc \
    && command -v cargo \
    && command -v cmake \
    && command -v make \
    && command -v java \
    && command -v javac

ENV HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PIP_CACHE_DIR=/tmp/pip-cache \
    CARGO_HOME=/tmp/cargo \
    GOCACHE=/tmp/go-cache \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace
USER 65532:65532
