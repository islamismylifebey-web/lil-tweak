ARG RUNNER_BASE_IMAGE
FROM ${RUNNER_BASE_IMAGE}

LABEL org.opencontainers.image.title="Lil Tweak sandbox runner" \
      org.opencontainers.image.description="Credential-free, network-disabled code execution toolchain"

RUN apt-get update \
    && apt-get purge --yes git git-man \
    && apt-get install --yes --no-install-recommends \
        cargo \
        cmake \
        default-jdk-headless \
        golang-go \
        make \
        patch \
        python3 \
        python3-pip \
        python3-pytest \
        python3-venv \
        rustc \
    && rm -rf /var/lib/apt/lists/* \
    && ! command -v git \
    && command -v patch

ENV HOME=/tmp \
    NPM_CONFIG_CACHE=/tmp/npm-cache \
    PIP_CACHE_DIR=/tmp/pip-cache \
    CARGO_HOME=/tmp/cargo \
    GOCACHE=/tmp/go-cache \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /workspace
USER 65532:65532
