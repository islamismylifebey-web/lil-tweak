# Copy to a root-readable staging directory as core.env; never commit the filled file.
LIL_TWEAK_DATABASE_URL=postgresql://lil_tweak_app:CHANGE_ME@lil-tweak-postgres:5432/lil_tweak
LIL_TWEAK_SIGNING_KEYS_JSON={"primary":"CHANGE_ME"}
# Exact 32-lowerhex owner scope sent in X-Lil-Tweak-Owner by the Cloudflare control plane.
LIL_TWEAK_CANONICAL_OWNER_ID=REPLACE_WITH_CF_OWNER_SCOPE_32_LOWERHEX
OPENAI_API_KEY=CHANGE_ME
LIL_TWEAK_OPENAI_MODEL=gpt-5.6-terra
LIL_TWEAK_RUNNER_IMAGE=registry.example.invalid/lil-tweak/runner@sha256:REPLACE_WITH_64_HEX_CHARACTERS
LIL_TWEAK_EXECUTION_BACKEND=local_podman
# github_actions only: change the backend above and uncomment both reviewed values.
# LIL_TWEAK_GITHUB_REPOSITORY=OWNER/REPOSITORY
# LIL_TWEAK_GITHUB_TOKEN=REPLACE
# Exact in-container path backed by the Quadlet's 1 GiB/204800-inode tmpfs; never a host bind.
LIL_TWEAK_WORK_ROOT=/var/lib/lil-tweak/work
LIL_TWEAK_WORK_ROOT_INODES=204800
LIL_TWEAK_MAX_ADMITTED_JOBS=1
LIL_TWEAK_JOB_TIMEOUT_SECONDS=1200
LIL_TWEAK_EVIDENCE_BUCKET=CHANGE_ME
LIL_TWEAK_EVIDENCE_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
LIL_TWEAK_R2_ACCESS_KEY_ID=CHANGE_ME
LIL_TWEAK_R2_SECRET_ACCESS_KEY=CHANGE_ME
# Optional. Must be one exact reachable HTTPS read-only endpoint; no redirects or proxy inheritance.
# Leave unset unless an isolated gateway exists without joining a GALOR network.
# LIL_TWEAK_GALOR_READONLY_URL=https://galor-readonly.internal/v1/project-context
# Optional comma-separated lowercase Git hosts for immutable commit intake.
# LIL_TWEAK_GIT_ALLOWED_HOSTS=git.example.invalid
