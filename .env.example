OPENAI_API_KEY=
LILTWEAK_MODEL=gpt-5.6-sol
LILTWEAK_ENVIRONMENT=development
LILTWEAK_DB_PATH=./data/liltweak.db
# Built-in server bind. The default keeps the private Workbench local.
# When the private Workbench is enabled, this must be a loopback IP literal.
LILTWEAK_SERVER_HOST=127.0.0.1
LILTWEAK_DEV_API_KEY=
LILTWEAK_OWNER_ID=maurice-pennington-bey
LILTWEAK_MONTHLY_BUDGET_USD=250
LILTWEAK_JOB_HARD_LIMIT_USD=5
LILTWEAK_PLANNING_RESERVATION_USD=1
LILTWEAK_WORKSPACE_ROOT=./repositories
LILTWEAK_REPOSITORIES_JSON={}
LILTWEAK_ARTIFACT_ROOT=./artifacts
# URL-safe base64 for exactly 32 random bytes. Never commit the real value.
LILTWEAK_ARTIFACT_ENCRYPTION_KEY=
# URL-safe base64 for exactly 32 random bytes. Required in production.
LILTWEAK_EVIDENCE_SIGNING_KEY=
LILTWEAK_CREATOR_SIGNING_KEY=
# Inert legacy intent only. The default app never auto-connects the Creator provider;
# bounded compatibility tests/evaluations must inject its controller explicitly.
LILTWEAK_LIVE_MODEL_ENABLED=false
LILTWEAK_LIVE_MONTHLY_LIMIT_USD=5
LILTWEAK_LIVE_CALL_LIMIT_USD=0.10
LILTWEAK_LIVE_INPUT_TOKEN_LIMIT=12000
LILTWEAK_LIVE_OUTPUT_TOKEN_LIMIT=1024
# Disabled until a dedicated runner passes the Phase 7 isolation qualification.
LILTWEAK_REPOSITORY_EXECUTION_ENABLED=false
LILTWEAK_EXECUTION_RUNTIME_ROOT=./runtime-root
# Immutable image reference only; leave empty while execution is disabled.
LILTWEAK_EXECUTION_IMAGE_REF=
# Private owner Workbench. Model and command execution remain disabled by default.
# MODEL_ENABLED expresses operator intent only; the app stays disconnected until trusted code
# explicitly injects an OpenAIResponsesReasoningProvider with the selected profile qualified.
LILTWEAK_WORKBENCH_ENABLED=false
LILTWEAK_WORKBENCH_MODEL_ENABLED=false
LILTWEAK_WORKBENCH_MODEL=gpt-5.6-sol
LILTWEAK_WORKBENCH_REASONING_TIER=high
LILTWEAK_WORKBENCH_REASONING_MODE=standard
LILTWEAK_WORKBENCH_REASONING_PROFILE=ordinary
LILTWEAK_WORKBENCH_WORKSPACE_ROOT=./workbench-tasks
LILTWEAK_WORKBENCH_SESSION_TTL_SECONDS=3600
LILTWEAK_WORKBENCH_RATE_LIMIT_PER_MINUTE=120
LILTWEAK_WORKBENCH_INPUT_TOKEN_LIMIT=144000
LILTWEAK_WORKBENCH_OUTPUT_TOKEN_LIMIT=25772
LILTWEAK_WORKBENCH_COST_CEILING_USD=1.50
LILTWEAK_WORKBENCH_MONTHLY_LIMIT_USD=5
# GALOR Runner V2 remains fail-closed until every signed server-held control is present and exact.
LILTWEAK_WORKBENCH_RUNNER_ENABLED=false
LILTWEAK_WORKBENCH_RUNNER_GATEWAY_URL=
LILTWEAK_WORKBENCH_RUNNER_CONTRACT_JSON=
LILTWEAK_WORKBENCH_RUNNER_EXPECTED_CONTRACT_DIGEST=
LILTWEAK_WORKBENCH_RUNNER_QUALIFICATION_DIGEST=
LILTWEAK_WORKBENCH_RUNNER_AUTHORIZATION_DIGEST=
LILTWEAK_WORKBENCH_RUNNER_AUTH_TOKEN=
LILTWEAK_WORKBENCH_RUNNER_AUTHORIZATION_SIGNING_KEYS_JSON=
LILTWEAK_WORKBENCH_RUNNER_SIGNING_KEYS_JSON=
LILTWEAK_WORKBENCH_RUNNER_REPOSITORY_ID=lil-tweak
LILTWEAK_WORKBENCH_RUNNER_REPOSITORY_COMMIT=

# Gate 3: full runner qualification and connection-authorization trust anchors.
LILTWEAK_WORKBENCH_RUNNER_QUALIFICATION_ISSUER_KEYS_JSON={}
LILTWEAK_WORKBENCH_RUNNER_QUALIFICATION_RUNNER_KEYS_JSON={}
LILTWEAK_WORKBENCH_RUNNER_QUALIFICATION_MAX_AGE_SECONDS=86400
LILTWEAK_WORKBENCH_RUNNER_CONNECTION_AUTHORIZATION_KEYS_JSON={}
LILTWEAK_WORKBENCH_RUNNER_CONNECTION_AUTHORIZATION_MINIMUM_SEQUENCE=0
LILTWEAK_WORKBENCH_RUNNER_CONNECTION_AUTHORIZATION_REVOCATION_EPOCH=1
