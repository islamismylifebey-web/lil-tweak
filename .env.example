OPENAI_API_KEY=
LILTWEAK_MODEL=gpt-5.6-luna
LILTWEAK_ENVIRONMENT=development
LILTWEAK_DB_PATH=./data/liltweak.db
LILTWEAK_DEV_API_KEY=
LILTWEAK_OWNER_ID=maurice-pennington-bey
LILTWEAK_MONTHLY_BUDGET_USD=250
LILTWEAK_JOB_HARD_LIMIT_USD=5
LILTWEAK_PLANNING_RESERVATION_USD=1
LILTWEAK_WORKSPACE_ROOT=./repositories
LILTWEAK_REPOSITORIES_JSON={}
LILTWEAK_ARTIFACT_ROOT=./artifacts
# URL-safe base64 for exactly 32 random bytes. Never commit the real value.
LILTWEAK_ARTIFACT_ENCRYPTION_KEY=
# URL-safe base64 for exactly 32 random bytes. Required in production.
LILTWEAK_EVIDENCE_SIGNING_KEY=
LILTWEAK_CREATOR_SIGNING_KEY=
# Disabled unless the trusted harness explicitly enables billable Creator calls.
LILTWEAK_LIVE_MODEL_ENABLED=false
LILTWEAK_LIVE_MONTHLY_LIMIT_USD=5
LILTWEAK_LIVE_CALL_LIMIT_USD=0.10
LILTWEAK_LIVE_INPUT_TOKEN_LIMIT=12000
LILTWEAK_LIVE_OUTPUT_TOKEN_LIMIT=1024
# Disabled until a dedicated runner passes the Phase 7 isolation qualification.
LILTWEAK_REPOSITORY_EXECUTION_ENABLED=false
LILTWEAK_EXECUTION_RUNTIME_ROOT=./runtime-root
# Immutable image reference only; leave empty while execution is disabled.
LILTWEAK_EXECUTION_IMAGE_REF=
